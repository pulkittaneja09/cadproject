# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# Storage Mode
STORAGE_MODE=local

# AWS Configuration (Optional - for cloud deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_DYNAMODB_TABLE=
AWS_LAMBDA_FUNCTION=

# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# AI Configuration (Legacy - kept for compatibility)
SENTIMENT_MODEL=gemini
ENABLE_AI_FALLBACK=true
